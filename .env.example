# Server
PORT=3000
NODE_ENV=development

# Postgres (used by docker-compose)
# Format: postgres://<user>:<password>@<host>:<port>/<db>
POSTGRES_DB=ledge
POSTGRES_USER=ledge
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ledge:change-me@db:5432/ledge

# API key for requests (keep secret in your local .env)
API_KEY=change-me

# Paths inside the container
SOURCE_DB_PATH=/app/northwind.db
RUNTIME_DB_PATH=/app/.runtime/northwind.db
NORTHWIND_SHA256=

# Business/config
FX_BASE_CURRENCY=USD
INGESTION_WINDOW_MINUTES=15